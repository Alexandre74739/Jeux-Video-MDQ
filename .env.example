# Copier ce fichier en .env (jamais commité) et dans les variables d'environnement Vercel.

# Base MongoDB Atlas de la sauvegarde en ligne
MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster.exemple.mongodb.net/

# Secret envoyé par Vercel aux tâches planifiées (/api/keepalive refuse tout appel sans lui)
CRON_SECRET=une-longue-chaine-aleatoire

# Adresse publique du site (métadonnées, sitemap, aperçus de liens)
NEXT_PUBLIC_SITE_URL=https://jeux-video-mdq.vercel.app

# E-mail de contact affiché dans les mentions légales et la politique de confidentialité
NEXT_PUBLIC_CONTACT_EMAIL=
